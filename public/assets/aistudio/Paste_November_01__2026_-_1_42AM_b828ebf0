/**
 * ULTIMATE HYBRID PREDICTION ENGINE v3.0
 * Combines 10 different prediction logics with weighted voting
 * Accuracy-optimized with adaptive confidence scoring
 */

class UltimateHybridPredictor {
    constructor() {
        this.version = "3.0";
        this.history = [];
        this.results = [];
        this.predictionHistory = [];
        this.accuracyTracker = {};
        this.weights = {};
        this.adaptiveMode = true;
        
        // Initialize weight tracking for each algorithm
        this.algorithms = [
            'fibonacci', 'gap', 'hotNumber', 'repetition', 
            'sumAnalysis', 'parity', 'consecutive', 'recentTrend',
            'markovChain', 'pattern100', 'singleLogic', 'moneyManagement',
            'bankaiScript', 'alsmarPapa', 'viratAI'
        ];
        
        this.algorithms.forEach(algo => {
            this.weights[algo] = 1.0;
            this.accuracyTracker[algo] = { correct: 0, total: 0 };
        });
    }

    /**
     * MAIN PREDICTION FUNCTION
     * Combines all algorithms with weighted voting
     */
    predict(historyNumbers, historySizes) {
        // Validate input
        if (!historyNumbers || historyNumbers.length < 5) {
            return this.getDefaultPrediction();
        }

        // Store history
        this.history = historyNumbers;
        this.historySizes = historySizes || historyNumbers.map(n => n >= 5 ? "BIG" : "SMALL");

        // Get predictions from all algorithms
        const predictions = this.getAllPredictions();
        
        // Calculate weighted scores
        const scores = this.calculateWeightedScores(predictions);
        
        // Get final prediction
        const finalPrediction = this.getFinalDecision(scores);
        
        // Calculate confidence (0-100)
        const confidence = this.calculateConfidence(scores, predictions);
        
        // Generate jackpot numbers
        const jackpotNumbers = this.generateJackpotNumbers(finalPrediction);
        
        // Generate reasoning
        const reasoning = this.generateReasoning(predictions, scores, finalPrediction);

        return {
            prediction: finalPrediction.prediction,
            confidence: confidence,
            numbers: jackpotNumbers,
            reasoning: reasoning,
            scores: scores,
            details: predictions,
            mode: this.determineMode(confidence)
        };
    }

    /**
     * GET ALL PREDICTIONS FROM EACH ALGORITHM
     */
    getAllPredictions() {
        const predictions = {};
        
        // 1. Fibonacci Pattern Analysis
        predictions.fibonacci = this.fibonacciAnalysis();
        
        // 2. Gap Analysis
        predictions.gap = this.gapAnalysis();
        
        // 3. Hot Numbers
        predictions.hotNumber = this.hotNumberAnalysis();
        
        // 4. Repetition Detection
        predictions.repetition = this.repetitionDetection();
        
        // 5. Sum Analysis
        predictions.sumAnalysis = this.sumAnalysis();
        
        // 6. Parity Analysis
        predictions.parity = this.parityAnalysis();
        
        // 7. Consecutive Analysis
        predictions.consecutive = this.consecutiveAnalysis();
        
        // 8. Recent Trend
        predictions.recentTrend = this.recentTrendAnalysis();
        
        // 9. Markov Chain
        predictions.markovChain = this.markovChainAnalysis();
        
        // 10. 100 Pattern Analysis
        predictions.pattern100 = this.pattern100Analysis();
        
        // 11. Single Logic
        predictions.singleLogic = this.singleLogicAnalysis();
        
        // 12. Money Management
        predictions.moneyManagement = this.moneyManagementAnalysis();
        
        // 13. Bankai Script
        predictions.bankaiScript = this.bankaiScriptAnalysis();
        
        // 14. Alsmar Papa
        predictions.alsmarPapa = this.alsmarPapaAnalysis();
        
        // 15. Virat AI
        predictions.viratAI = this.viratAIAnalysis();

        return predictions;
    }

    /**
     * 1. FIBONACCI PATTERN ANALYSIS
     */
    fibonacciAnalysis() {
        const nums = this.history;
        if (nums.length < 3) return { prediction: "BIG", confidence: 50 };
        
        const avg = (nums[0] + nums[1] + nums[2]) / 3;
        const prediction = avg > 4.5 ? "BIG" : "SMALL";
        const confidence = Math.min(85, 60 + Math.abs(avg - 4.5) * 10);
        
        return { prediction, confidence: Math.round(confidence) };
    }

    /**
     * 2. GAP ANALYSIS
     */
    gapAnalysis() {
        const nums = this.history;
        if (nums.length < 2) return { prediction: "BIG", confidence: 50 };
        
        let gaps = [];
        for (let i = 0; i < nums.length - 1; i++) {
            gaps.push(Math.abs(nums[i] - nums[i + 1]));
        }
        const avgGap = gaps.reduce((a, b) => a + b, 0) / gaps.length;
        const prediction = avgGap > 4 ? "BIG" : "SMALL";
        const confidence = Math.min(82, 55 + Math.abs(avgGap - 4) * 8);
        
        return { prediction, confidence: Math.round(confidence) };
    }

    /**
     * 3. HOT NUMBER ANALYSIS
     */
    hotNumberAnalysis() {
        const nums = this.history;
        const freq = Array(10).fill(0);
        nums.forEach(n => freq[n]++);
        
        const max = Math.max(...freq);
        const hot = [];
        freq.forEach((count, i) => {
            if (count === max) hot.push(i);
        });
        
        const hotPrediction = hot.filter(n => n >= 5).length >= hot.filter(n => n < 5).length 
            ? "BIG" : "SMALL";
        const confidence = Math.min(88, 65 + (max / nums.length) * 30);
        
        return { prediction: hotPrediction, confidence: Math.round(confidence) };
    }

    /**
     * 4. REPETITION DETECTION
     */
    repetitionDetection() {
        const sizes = this.historySizes;
        if (sizes.length < 2) return { prediction: "BIG", confidence: 50 };
        
        let prediction;
        if (sizes[0] === sizes[1]) {
            prediction = sizes[0] === 'BIG' ? 'SMALL' : 'BIG';
        } else {
            prediction = sizes[0];
        }
        
        const confidence = sizes.length > 5 ? 78 : 60;
        return { prediction, confidence };
    }

    /**
     * 5. SUM ANALYSIS
     */
    sumAnalysis() {
        const nums = this.history;
        if (nums.length < 3) return { prediction: "BIG", confidence: 50 };
        
        const sum = nums.slice(0, 3).reduce((a, b) => a + b, 0);
        const prediction = sum > 13.5 ? "BIG" : "SMALL";
        const confidence = Math.min(80, 55 + Math.abs(sum - 13.5) * 4);
        
        return { prediction, confidence: Math.round(confidence) };
    }

    /**
     * 6. PARITY ANALYSIS
     */
    parityAnalysis() {
        const nums = this.history;
        const evens = nums.filter(n => n % 2 === 0).length;
        const prediction = evens > nums.length / 2 ? "BIG" : "SMALL";
        const confidence = Math.min(75, 55 + Math.abs(evens - nums.length/2) * 10);
        
        return { prediction, confidence: Math.round(confidence) };
    }

    /**
     * 7. CONSECUTIVE ANALYSIS
     */
    consecutiveAnalysis() {
        const nums = this.history;
        let count = 0;
        for (let i = 0; i < nums.length - 1; i++) {
            if (Math.abs(nums[i] - nums[i + 1]) === 1) count++;
        }
        const prediction = count > 2 ? 'SMALL' : 'BIG';
        const confidence = Math.min(72, 55 + count * 5);
        
        return { prediction, confidence: Math.round(confidence) };
    }

    /**
     * 8. RECENT TREND ANALYSIS
     */
    recentTrendAnalysis() {
        const sizes = this.historySizes.slice(0, 5);
        const bigs = sizes.filter(s => s === 'BIG').length;
        const smalls = sizes.filter(s => s === 'SMALL').length;
        const prediction = bigs >= smalls ? 'BIG' : 'SMALL';
        const confidence = Math.min(85, 60 + Math.abs(bigs - smalls) * 8);
        
        return { prediction, confidence: Math.round(confidence) };
    }

    /**
     * 9. MARKOV CHAIN ANALYSIS
     */
    markovChainAnalysis() {
        const nums = this.history;
        if (nums.length < 3) return { prediction: "BIG", confidence: 50 };
        
        const transitions = new Map();
        for (let i = 0; i < nums.length - 2; i++) {
            const key = `${nums[i]},${nums[i+1]}`;
            const next = nums[i+2] >= 5 ? "BIG" : "SMALL";
            if (!transitions.has(key)) {
                transitions.set(key, { BIG: 0, SMALL: 0 });
            }
            transitions.get(key)[next]++;
        }
        
        const lastTwo = nums.slice(-2);
        const key = `${lastTwo[0]},${lastTwo[1]}`;
        const stats = transitions.get(key) || { BIG: 0, SMALL: 0 };
        const total = stats.BIG + stats.SMALL;
        
        if (total === 0) return { prediction: "BIG", confidence: 50 };
        
        const prediction = stats.BIG >= stats.SMALL ? "BIG" : "SMALL";
        const confidence = Math.min(90, 60 + (Math.max(stats.BIG, stats.SMALL) / total) * 30);
        
        return { prediction, confidence: Math.round(confidence) };
    }

    /**
     * 10. 100 PATTERN ANALYSIS (from Alsmar Papa)
     */
    pattern100Analysis() {
        const nums = this.history;
        const sizes = this.historySizes;
        
        // Use the sophisticated pattern detection from logic 5
        const numberScores = Array(10).fill(0);
        const sizeScores = { BIG: 0, SMALL: 0 };
        
        const last = nums[nums.length - 1];
        const lastSize = sizes[sizes.length - 1];
        
        // Pattern: Single Repeat
        numberScores[last] += 12;
        
        // Pattern: Double Repeat
        if (nums.length >= 2 && nums[nums.length - 1] === nums[nums.length - 2]) {
            numberScores[last] += 18;
        }
        
        // Pattern: Triple Repeat
        if (nums.length >= 3 && 
            nums[nums.length - 1] === nums[nums.length - 2] &&
            nums[nums.length - 2] === nums[nums.length - 3]) {
            numberScores[last] += 25;
        }
        
        // Pattern: Size Streaks
        if (sizes.length >= 2 && sizes[sizes.length - 1] === sizes[sizes.length - 2]) {
            if (lastSize === "BIG") {
                sizeScores.BIG += 18;
                // Reversal after triple
                if (sizes.length >= 3 && sizes.slice(-3).every(s => s === "BIG")) {
                    sizeScores.SMALL += 22;
                }
            } else {
                sizeScores.SMALL += 18;
                if (sizes.length >= 3 && sizes.slice(-3).every(s => s === "SMALL")) {
                    sizeScores.BIG += 22;
                }
            }
        }
        
        // Pattern: Number Comeback (gap > 5)
        for (let i = 0; i <= 9; i++) {
            const lastIdx = nums.lastIndexOf(i);
            if (lastIdx !== -1 && (nums.length - lastIdx) > 5) {
                numberScores[i] += 15;
            }
        }
        
        // Pattern: Cold Numbers (gap > 10)
        const lastOccurrence = Array(10).fill(-1);
        nums.forEach((n, idx) => lastOccurrence[n] = idx);
        for (let i = 0; i <= 9; i++) {
            if (lastOccurrence[i] !== -1 && (nums.length - lastOccurrence[i]) > 10) {
                numberScores[i] += 14;
            }
        }
        
        // Pattern: Mirror Repeat
        const mirror = 9 - last;
        numberScores[mirror] += 10;
        
        // Pattern: Gap Analysis
        if (nums.length >= 2) {
            const lastGap = Math.abs(last - nums[nums.length - 2]);
            if (lastGap === 1) {
                const neighbors = [last - 1, last + 1].filter(x => x >= 0 && x <= 9);
                neighbors.forEach(n => numberScores[n] += 12);
            }
            if (lastGap === 2) {
                const neighbors = [last - 2, last + 2].filter(x => x >= 0 && x <= 9);
                neighbors.forEach(n => numberScores[n] += 10);
            }
        }
        
        // Pattern: Odd/Even
        const isOdd = last % 2 === 1;
        if (isOdd) {
            for (let i = 1; i <= 9; i += 2) numberScores[i] += 8;
        } else {
            for (let i = 0; i <= 9; i += 2) numberScores[i] += 8;
        }
        
        // Pattern: Prime Numbers
        const primes = [2, 3, 5, 7];
        if (primes.includes(last)) {
            primes.forEach(p => numberScores[p] += 7);
        }
        
        // Pattern: Trend Up/Down
        if (nums.length >= 2) {
            const diff = last - nums[nums.length - 2];
            if (diff > 0) {
                for (let i = Math.min(9, last + 1); i <= Math.min(9, last + 2); i++) {
                    numberScores[i] += 9;
                }
            } else if (diff < 0) {
                for (let i = Math.max(0, last - 2); i <= Math.max(0, last - 1); i++) {
                    numberScores[i] += 9;
                }
            }
        }
        
        // Pattern: Hot Number (most frequent last 15)
        const freq = Array(10).fill(0);
        nums.slice(-15).forEach(n => freq[n]++);
        const maxFreq = Math.max(...freq);
        if (maxFreq > 0) {
            for (let i = 0; i <= 9; i++) {
                if (freq[i] === maxFreq) {
                    numberScores[i] += 16;
                }
            }
        }
        
        // Determine prediction
        let maxScore = Math.max(...numberScores);
        let predictedNumber = numberScores.indexOf(maxScore);
        
        if (maxScore === 0) {
            predictedNumber = (last + 3) % 10;
        }
        
        let predictedSize = predictedNumber >= 5 ? "BIG" : "SMALL";
        
        // Adjust based on size scores
        if (sizeScores.BIG > sizeScores.SMALL + 10) {
            predictedSize = "BIG";
        } else if (sizeScores.SMALL > sizeScores.BIG + 10) {
            predictedSize = "SMALL";
        }
        
        // Ensure number matches size
        if (predictedSize === "BIG" && predictedNumber < 5) {
            let bestBig = 5;
            let bestBigScore = -1;
            [5,6,7,8,9].forEach(n => {
                if (numberScores[n] > bestBigScore) {
                    bestBigScore = numberScores[n];
                    bestBig = n;
                }
            });
            predictedNumber = bestBig;
        }
        
        if (predictedSize === "SMALL" && predictedNumber > 4) {
            let bestSmall = 0;
            let bestSmallScore = -1;
            [0,1,2,3,4].forEach(n => {
                if (numberScores[n] > bestSmallScore) {
                    bestSmallScore = numberScores[n];
                    bestSmall = n;
                }
            });
            predictedNumber = bestSmall;
        }
        
        const confidence = Math.min(94, 60 + Math.floor(maxScore / 6));
        
        return { 
            prediction: predictedSize, 
            confidence: Math.round(confidence),
            number: predictedNumber
        };
    }

    /**
     * 11. SINGLE LOGIC ANALYSIS (from logic 9)
     */
    singleLogicAnalysis() {
        const nums = this.history;
        const trends = this.historySizes;
        
        if (trends.length < 5) return { prediction: "BIG", confidence: 50 };
        
        // Calculate trend strength
        let bigCount = 0, smallCount = 0;
        for (let i = 0; i < Math.min(10, trends.length); i++) {
            trends[i] === "BIG" ? bigCount++ : smallCount++;
        }
        
        // Calculate momentum
        const recentAvg = nums.slice(0, 5).reduce((a, b) => a + b, 0) / 5;
        const momentumBias = recentAvg >= 5 ? "BIG" : "SMALL";
        const momentumStrength = Math.abs(recentAvg - 4.5) / 4.5;
        
        // Calculate mean reversion
        const overallAvg = nums.slice(0, 20).reduce((a, b) => a + b, 0) / 20;
        const reversionSignal = overallAvg > 4.5 ? "SMALL" : "BIG";
        
        // Calculate alternation
        let alternations = 0;
        for (let i = 0; i < Math.min(5, trends.length - 1); i++) {
            if (trends[i] !== trends[i + 1]) alternations++;
        }
        const patternScore = alternations / 4;
        
        // Decision
        let prediction;
        let confidence;
        const trendWeight = Math.abs(bigCount - smallCount) / 10;
        
        if (trendWeight > 0.6 && patternScore < 0.3) {
            prediction = bigCount > smallCount ? "BIG" : "SMALL";
            confidence = 95 + (trendWeight * 5);
        } else if (patternScore > 0.7 && trendWeight < 0.4) {
            prediction = trends[0] === "BIG" ? "SMALL" : "BIG";
            confidence = 93 + (patternScore * 7);
        } else {
            prediction = reversionSignal;
            confidence = 90 + (momentumStrength * 5);
            if (momentumBias === prediction) confidence += 3;
        }
        
        return { 
            prediction, 
            confidence: Math.min(99, Math.round(confidence))
        };
    }

    /**
     * 12. MONEY MANAGEMENT ANALYSIS (from logic 8)
     */
    moneyManagementAnalysis() {
        const nums = this.history;
        const sizes = this.historySizes;
        
        if (sizes.length < 5) return { prediction: "BIG", confidence: 50 };
        
        let sum = 0;
        const period = String(Date.now()).slice(-4);
        for (let i = 0; i < Math.min(4, period.length); i++) {
            sum += parseInt(period[i] || '0');
        }
        const lastDigit = sum % 10;
        
        let prediction = lastDigit <= 4 ? "SMALL" : "BIG";
        let confidence = 50;
        
        // Analyze recent patterns
        if (sizes.length >= 5) {
            let recentSmall = sizes.filter(s => s === "SMALL").length;
            let recentBig = sizes.filter(s => s === "BIG").length;
            let totalRecent = recentSmall + recentBig;
            
            if (totalRecent > 0) {
                let smallRatio = (recentSmall / totalRecent) * 100;
                let bigRatio = (recentBig / totalRecent) * 100;
                
                if (smallRatio > 70 && prediction === "SMALL") {
                    confidence = 75 + Math.random() * 10;
                } else if (bigRatio > 70 && prediction === "BIG") {
                    confidence = 75 + Math.random() * 10;
                } else if (smallRatio > 70 && prediction === "BIG") {
                    confidence = 70 + Math.random() * 10;
                } else if (bigRatio > 70 && prediction === "SMALL") {
                    confidence = 70 + Math.random() * 10;
                } else {
                    confidence = 50 + Math.random() * 10;
                }
            }
        }
        
        return { 
            prediction, 
            confidence: Math.min(95, Math.round(confidence))
        };
    }

    /**
     * 13. BANKAI SCRIPT ANALYSIS (from logic 6)
     */
    bankaiScriptAnalysis() {
        const sizes = this.historySizes;
