    /**
     * 14. ALSMAR PAPA ANALYSIS (from logic 5 enhanced)
     */
    alsmarPapaAnalysis() {
        const nums = this.history;
        const sizes = this.historySizes;
        
        if (nums.length < 5) return { prediction: "BIG", confidence: 50 };
        
        // Use the comprehensive pattern detection
        const numberScores = Array(10).fill(0);
        const sizeScores = { BIG: 0, SMALL: 0 };
        
        const last = nums[nums.length - 1];
        const lastSize = sizes[sizes.length - 1];
        
        // Single Repeat
        numberScores[last] += 12;
        
        // Double Repeat
        if (nums.length >= 2 && nums[nums.length - 1] === nums[nums.length - 2]) {
            numberScores[last] += 18;
        }
        
        // Size Patterns
        if (sizes.length >= 2) {
            if (sizes[sizes.length - 1] === "BIG" && sizes[sizes.length - 2] === "BIG") {
                sizeScores.BIG += 18;
            }
            if (sizes[sizes.length - 1] === "SMALL" && sizes[sizes.length - 2] === "SMALL") {
                sizeScores.SMALL += 18;
            }
        }
        
        // Color Patterns
        const colors = nums.map(n => n < 5 ? "RED" : "GREEN");
        const lastColor = colors[colors.length - 1];
        
        if (colors.length >= 2 && colors[colors.length - 1] === colors[colors.length - 2]) {
            if (lastColor === "RED") {
                for (let i = 0; i <= 4; i++) numberScores[i] += 10;
            } else {
                for (let i = 5; i <= 9; i++) numberScores[i] += 10;
            }
        }
        
        // Number Comeback
        for (let i = 0; i <= 9; i++) {
            const lastIdx = nums.lastIndexOf(i);
            if (lastIdx !== -1 && (nums.length - lastIdx) > 5) {
                numberScores[i] += 15;
            }
        }
        
        // Mirror
        const mirror = 9 - last;
        numberScores[mirror] += 10;
        
        // Gap Patterns
        if (nums.length >= 2) {
            const lastGap = Math.abs(last - nums[nums.length - 2]);
            if (lastGap === 1) {
                [last - 1, last + 1].filter(x => x >= 0 && x <= 9)
                    .forEach(n => numberScores[n] += 12);
            }
        }
        
        // Odd/Even
        const isOdd = last % 2 === 1;
        if (isOdd) {
            for (let i = 1; i <= 9; i += 2) numberScores[i] += 8;
        } else {
            for (let i = 0; i <= 9; i += 2) numberScores[i] += 8;
        }
        
        // Prime
        const primes = [2, 3, 5, 7];
        if (primes.includes(last)) {
            primes.forEach(p => numberScores[p] += 7);
        }
        
        // High/Low
        if (last >= 5) {
            for (let i = 5; i <= 9; i++) numberScores[i] += 8;
        } else {
            for (let i = 0; i <= 4; i++) numberScores[i] += 8;
        }
        
        // Trend
        if (nums.length >= 2) {
            const diff = last - nums[nums.length - 2];
            if (diff > 0) {
                for (let i = Math.min(9, last + 1); i <= Math.min(9, last + 2); i++) {
                    numberScores[i] += 9;
                }
            } else if (diff < 0) {
                for (let i = Math.max(0, last - 2); i <= Math.max(0, last - 1); i++) {
                    numberScores[i] += 9;
                }
            }
        }
        
        // Hot Number
        const freq = Array(10).fill(0);
        nums.slice(-15).forEach(n => freq[n]++);
        const maxFreq = Math.max(...freq);
        if (maxFreq > 0) {
            for (let i = 0; i <= 9; i++) {
                if (freq[i] === maxFreq) {
                    numberScores[i] += 16;
                }
            }
        }
        
        // Final
        let maxScore = Math.max(...numberScores);
        let predictedNumber = numberScores.indexOf(maxScore);
        
        if (maxScore === 0) {
            predictedNumber = (last + 3) % 10;
        }
        
        let predictedSize = predictedNumber >= 5 ? "BIG" : "SMALL";
        
        if (sizeScores.BIG > sizeScores.SMALL + 10) {
            predictedSize = "BIG";
        } else if (sizeScores.SMALL > sizeScores.BIG + 10) {
            predictedSize = "SMALL";
        }
        
        const confidence = Math.min(94, 60 + Math.floor(maxScore / 6));
        
        return { 
            prediction: predictedSize, 
            confidence: Math.round(confidence)
        };
    }

    /**
     * 15. VIRAT AI ANALYSIS (from logic 4)
     */
    viratAIAnalysis() {
        const nums = this.history;
        if (nums.length < 10) return { prediction: "BIG", confidence: 50 };
        
        // Markov Bias
        let transitions = new Map();
        for (let i = 0; i < nums.length - 2; i++) {
            const key = `${nums[i]},${nums[i+1]},${nums[i+2]}`;
            transitions.set(key, (transitions.get(key) || 0) + 1);
        }
        
        const lastTwo = [nums[nums.length-2], nums[nums.length-1]];
        let big = 0, small = 0;
        for (let [key, val] of transitions) {
            const parts = key.split(',').map(Number);
            if (parts[0] === lastTwo[0] && parts[1] === lastTwo[1]) {
                if (parts[2] >= 5) big += val;
                else small += val;
            }
        }
        const total = big + small;
        const markovScore = total > 0 ? big / total : 0.5;
        
        // Entropy
        const freq = Array(10).fill(0);
        const slice = nums.slice(-30);
        for (let n of slice) freq[n]++;
        let ent = 0;
        for (let i = 0; i < 10; i++) {
            if (freq[i] > 0) {
                const p = freq[i] / slice.length;
                ent -= p * Math.log2(p);
            }
        }
        const entropyScore = ent / Math.log2(10);
        
        // Monte Carlo
        let bigCount = 0;
        const samplePool = nums.slice(-20);
        for (let i = 0; i < 300; i++) {
            const sample = [];
            for (let j = 0; j < 10; j++) {
                sample.push(samplePool[Math.floor(Math.random() * samplePool.length)]);
            }
            const bigInSample = sample.filter(x => x >= 5).length;
            if (bigInSample > 5) bigCount++;
        }
        const monteScore = bigCount / 300;
        
        // Combined
        const trendStrength = (markovScore * 0.4) + (monteScore * 0.4);
        const randomness = entropyScore;
        
        let prediction, confidence;
        let currentLoss = 0; // Track losses if available
        
        if (randomness > 0.85) {
            prediction = ["BIG", "SMALL"][Math.floor(Math.random() * 2)];
            confidence = 55;
        } else if (trendStrength > 0.55) {
            prediction = "BIG";
            confidence = Math.min(99, Math.abs(trendStrength - 0.5) * 200);
        } else if (trendStrength < 0.45) {
            prediction = "SMALL";
            confidence = Math.min(99, Math.abs(trendStrength - 0.5) * 200);
        } else {
            prediction = ["BIG", "SMALL"][Math.floor(Math.random() * 2)];
            confidence = 55;
        }
        
        return { 
            prediction, 
            confidence: Math.max(55, Math.min(99, Math.floor(confidence)))
        };
    }

    /**
     * CALCULATE WEIGHTED SCORES
     */
    calculateWeightedScores(predictions) {
        const scores = { BIG: 0, SMALL: 0 };
        const weights = { BIG: 0, SMALL: 0 };
        
        for (const [algo, result] of Object.entries(predictions)) {
            const weight = this.weights[algo] || 1.0;
            const confidence = result.confidence / 100;
            
            if (result.prediction === "BIG") {
                scores.BIG += weight * confidence;
                weights.BIG += weight;
            } else {
                scores.SMALL += weight * confidence;
                weights.SMALL += weight;
            }
        }
        
        // Normalize
        if (weights.BIG > 0) scores.BIG /= weights.BIG;
        if (weights.SMALL > 0) scores.SMALL /= weights.SMALL;
        
        return scores;
    }

    /**
     * GET FINAL DECISION
     */
    getFinalDecision(scores) {
        const total = scores.BIG + scores.SMALL;
        
        if (total === 0) {
            return { prediction: "BIG", score: 50 };
        }
        
        const bigPercentage = (scores.BIG / total) * 100;
        const smallPercentage = (scores.SMALL / total) * 100;
        
        // Require at least 55% for a confident prediction
        if (bigPercentage > 55) {
            return { prediction: "BIG", score: bigPercentage };
        } else if (smallPercentage > 55) {
            return { prediction: "SMALL", score: smallPercentage };
        } else {
            // Too close - use trend
            const lastTrend = this.historySizes[0] || "BIG";
            return { 
                prediction: lastTrend, 
                score: 50,
                note: "Tie-breaker: Following recent trend"
            };
        }
    }

    /**
     * CALCULATE CONFIDENCE
     */
    calculateConfidence(scores, predictions) {
        const total = scores.BIG + scores.SMALL;
        if (total === 0) return 50;
        
        const maxScore = Math.max(scores.BIG, scores.SMALL);
        const baseConfidence = (maxScore / total) * 100;
        
        // Adjust based on agreement among algorithms
        const predictionsList = Object.values(predictions);
        const bigCount = predictionsList.filter(p => p.prediction === "BIG").length;
        const totalAlgos = predictionsList.length;
        const agreement = Math.max(bigCount, totalAlgos - bigCount) / totalAlgos;
        
        // Combined confidence
        let confidence = (baseConfidence * 0.6) + (agreement * 100 * 0.4);
        
        // Additional boost if high confidence
        if (confidence > 85) confidence += 5;
        if (confidence > 95) confidence = 98;
        
        return Math.round(Math.min(98, Math.max(50, confidence)));
    }

    /**
     * GENERATE JACKPOT NUMBERS
     */
    generateJackpotNumbers(prediction) {
        const nums = this.history;
        const freq = Array(10).fill(0);
        nums.forEach(n => freq[n]++);
        
        let primary, secondary;
        
        if (prediction.prediction === "BIG") {
            const bigPool = [5, 6, 7, 8, 9];
            const sortedBig = bigPool.sort((a, b) => freq[b] - freq[a]);
            primary = sortedBig[0] || 7;
            secondary = sortedBig[1] || 5;
        } else {
            const smallPool = [0, 1, 2, 3, 4];
            const sortedSmall = smallPool.sort((a, b) => freq[b] - freq[a]);
            primary = sortedSmall[0] || 2;
            secondary = sortedSmall[1] || 0;
        }
        
        // Ensure they're different
        if (primary === secondary) {
            secondary = (primary + 3) % 10;
        }
        
        return [primary, secondary];
    }

    /**
     * GENERATE REASONING
     */
    generateReasoning(predictions, scores, finalPrediction) {
        const lines = [
            "🧠 ULTIMATE HYBRID PREDICTION ENGINE v3.0",
            "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
            "",
            "📊 ALGORITHM VOTING:"
        ];
        
        // Show top contributing algorithms
        const contributions = Object.entries(predictions)
            .sort((a, b) => b[1].confidence - a[1].confidence)
            .slice(0, 5);
        
        contributions.forEach(([algo, result]) => {
            const weight = this.weights[algo] || 1.0;
            lines.push(`  • ${algo}: ${result.prediction} (${result.confidence}%) [weight: ${weight.toFixed(2)}]`);
        });
        
        lines.push("");
        lines.push(`📈 SCORES: BIG=${scores.BIG.toFixed(2)} | SMALL=${scores.SMALL.toFixed(2)}`);
        lines.push(`🎯 FINAL: ${finalPrediction.prediction} (${finalPrediction.score.toFixed(0)}%)`);
        
        if (finalPrediction.note) {
            lines.push(`ℹ️ ${finalPrediction.note}`);
        }
        
        lines.push("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        lines.push("⚡ Powered by 15 AI Algorithms ⚡");
        
        return lines.join("\n");
    }

    /**
     * DETERMINE MODE
     */
    determineMode(confidence) {
        if (confidence >= 90) return "STRONG";
        if (confidence >= 80) return "MODERATE";
        if (confidence >= 70) return "CAUTIOUS";
        return "WAIT";
    }

    /**
     * DEFAULT PREDICTION
     */
    getDefaultPrediction() {
        return {
            prediction: "BIG",
            confidence: 50,
            numbers: [5, 2],
            reasoning: "⚠️ Insufficient data - using default prediction\n📊 Please provide more history for accuracy",
            mode: "WAIT"
        };
    }

    /**
     * UPDATE WEIGHTS BASED ON PERFORMANCE
     */
    updateWeights(actualResult) {
        for (const [algo, result] of Object.entries(this.predictionHistory)) {
            if (result.prediction === actualResult) {
                this.accuracyTracker[algo].correct++;
                this.weights[algo] = Math.min(2.0, this.weights[algo] * 1.05);
            } else {
                this.weights[algo] = Math.max(0.5, this.weights[algo] * 0.95);
            }
            this.accuracyTracker[algo].total++;
        }
    }
}

